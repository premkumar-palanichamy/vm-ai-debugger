# ── LLM API Keys ──────────────────────────────────────────────────────
# Add one or more — auto-detects mode (1 key=single, 2+=ensemble)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Uncomment to add more models for ensemble:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=your_new_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# ── VM Definitions ────────────────────────────────────────────────────
# Format: VM_{NUMBER}_{PROPERTY}
# Required per VM: HOST, USER, PASSWORD
# Optional per VM: NAME, PORT, USE_SSL, SQLSERVER_HOST, SQLSERVER_USER,
#                  SQLSERVER_PASSWORD, SQLSERVER_DATABASES, SQLSERVER_DB_FILTER


# ── Windows VM (WinRM) ────────────────────────────────────────────────
VM_WINDOWS_HOST=
VM_WINDOWS_USER=Administrator
VM_WINDOWS_PASSWORD=
VM_WINDOWS_PORT=5985
VM_WINDOWS_USE_SSL=false

# ── Linux VM (SSH) ────────────────────────────────────────────────────
# VM_LINUX_HOST=
# VM_LINUX_USER=ubuntu
# VM_LINUX_SSH_KEY=~/.ssh/id_rsa
# VM_LINUX_PORT=22

# ── SQL Server ────────────────────────────────────────────────────────
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=false
# Comma-separated list of databases to inspect:
# SQLSERVER_DATABASES=QA1-Core,QA2-Core   ← optional: list specific DBs
                                             # if not set → auto-discovers ALL databases
# SQLSERVER_DB_FILTER=QA                    ← optional: only inspect DBs starting with 'QA'

# ── MySQL (if you have MySQL instead of SQL Server) ───────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASES=db1,db2,db3

# ── App ───────────────────────────────────────────────────────────────
DB_PATH=vm_debugger.db
